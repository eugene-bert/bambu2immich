# Bambu Lab printer
BAMBU_IP=192.168.x.x
BAMBU_ACCESS_CODE=your_access_code
BAMBU_SERIAL=your_printer_serial

# Immich
IMMICH_URL=http://immich_server:2283
IMMICH_API_KEY=your_immich_api_key

# Optional: Telegram notifications
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Optional: keep local copies after upload (default: false)
# KEEP_LOCAL=false

# Optional: download directory (default: /data/timelapses)
# DOWNLOAD_DIR=/data/timelapses
